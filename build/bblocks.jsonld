  "validationReportJson": "https://ogcincubator.github.io/bblocks-cesium-viewer/build/tests/report.json",
  "imports": [
    "https://opengeospatial.github.io/bblocks/register.json"
  ],
  "viewer": {
    "viewPlugins": [
      {
        "url": "https://cdn.jsdelivr.net/gh/ogcincubator/bblocks-cesium-viewer@dist/index.js",
        "export": "TopoFeatureCesiumPlugin"
      }
    ]
  },
